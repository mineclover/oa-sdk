{
  "name": "@oa-sdk/typia-mock",
  "version": "0.1.0",
  "description": "Mock validation server for LLM function calls using typia's ILlmApplication pipeline",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/core": "workspace:*",
    "@oa-sdk/parser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "typia": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "typia": {
      "optional": true
    }
  }
}
