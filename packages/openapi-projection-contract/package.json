{
  "name": "@oa-sdk/openapi-projection-contract",
  "version": "0.2.0",
  "description": "Shared OpenAPI projection contract types for schema projection adapters",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "pnpm build && vitest run",
    "test:ci": "pnpm build && vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
