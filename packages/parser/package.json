{
  "name": "@oa-sdk/parser",
  "version": "0.1.0",
  "description": "OpenAPI 3.2 spec parser — Parse/Transform/Fold pipeline",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser.js",
      "types": "./dist/browser.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm --dts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/core": "workspace:*",
    "@oa-sdk/openapi-projection-contract": "workspace:*",
    "ajv": "^8.17.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
