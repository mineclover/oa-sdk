{
  "name": "@oa-sdk/mcp-mesh",
  "version": "0.1.0",
  "description": "Multi-MCP Hub, 1:N Domain Skill vs Session Instance Registry, WebMCP Skill Hydration, and Meta-Skill Orchestrator",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oa-mesh": "./dist/cli/bin.js",
    "oa-tools": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts src/cli/bin.ts --format esm --dts",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/collab-workspace": "workspace:*",
    "@oa-sdk/peer-server": "workspace:*",
    "@oa-sdk/peer-transport": "workspace:*",
    "@oa-sdk/tools": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
