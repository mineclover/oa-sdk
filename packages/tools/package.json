{
  "name": "@oa-sdk/tools",
  "version": "0.2.2",
  "description": "Universal Tool Engine for Model Context Protocol (MCP), Commander CLI, and Hono REST APIs",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external @oa-sdk/chunk-stream-ui --external @oa-sdk/peer-transport",
    "dev": "tsup src/index.ts --format esm --dts --watch --external @oa-sdk/chunk-stream-ui --external @oa-sdk/peer-transport",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.5.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "hono": "^4.13.13"
  },
  "peerDependencies": {
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oa-sdk/chunk-stream": "workspace:*",
    "@oa-sdk/chunk-stream-ui": "workspace:*",
    "@oa-sdk/peer-transport": "workspace:*",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.4.3"
  }
}
