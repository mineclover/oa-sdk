{
  "name": "@oa-sdk/telemetry",
  "version": "0.2.0",
  "description": "Design-driven telemetry, tracking symbol registry, XState v5 inspector, and DPM pseudonymization bridge",
  "private": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12",
    "xstate": "^5.19.2"
  },
  "peerDependencies": {
    "xstate": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "xstate": {
      "optional": true
    }
  }
}
