{
  "name": "@oa-sdk/rpc",
  "version": "0.1.0",
  "description": "Call and serve TypeSpec/OpenAPI operations as typed RPC procedures over JSON-RPC 2.0 or their REST routes",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ajv": {
      "types": "./dist/ajv.d.ts",
      "import": "./dist/ajv.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/ajv.ts --format esm --dts --external ajv",
    "test": "pnpm build && vitest run",
    "test:ci": "pnpm build && vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/surface-ir": "workspace:*"
  },
  "peerDependencies": {
    "ajv": "^8.17.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oa-sdk/parser": "workspace:*",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "tsup": "^8.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
