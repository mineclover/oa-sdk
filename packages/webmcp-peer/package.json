{
  "name": "@oa-sdk/webmcp-peer",
  "version": "0.1.0",
  "description": "Unified WebMCP Peer Server Routing, Browser Provider, and External Agent Client SDK",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/config.ts src/client.ts src/provider.ts src/server.ts --format esm --dts",
    "test": "pnpm build && vitest run",
    "test:ci": "pnpm build && vitest run --maxWorkers 1 --no-file-parallelism",
    "smoke": "node --import tsx examples/local-smoke.ts",
    "smoke:serve": "node --import tsx examples/local-smoke.ts --serve",
    "demo": "node --import tsx examples/live-demo.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
