{
  "name": "@oa-sdk/infra-gitlab",
  "version": "0.0.0",
  "private": true,
  "description": "Pulumi preset: GitLab CE Omnibus + GitLab Runner on local Docker. Phase 1 of the GitLab-based DevOps infrastructure that backs Symphony orchestration.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "build:cloud-vm": "tsup src/cloud-vm/index.ts --format esm --dts --outDir dist/cloud-vm",
    "typecheck": "tsc --noEmit",
    "typecheck:cloud-vm": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --esModuleInterop --types node src/cloud-vm/index.ts src/cloud-vm/config.ts src/cloud-vm/user-data.ts",
    "preview": "pulumi preview",
    "preview:k3s": "pulumi preview --config infra-gitlab:target=k3s",
    "preview:cloud-vm": "pulumi -C cloud-vm preview",
    "up": "pulumi up",
    "up:k3s": "pulumi up --config infra-gitlab:target=k3s",
    "up:cloud-vm": "pulumi -C cloud-vm up",
    "down": "pulumi destroy",
    "down:k3s": "pulumi destroy --config infra-gitlab:target=k3s",
    "down:cloud-vm": "pulumi -C cloud-vm destroy",
    "stack:init": "pulumi stack init dev || true",
    "stack:init:cloud-vm": "pulumi -C cloud-vm stack init dev || true",
    "login:local": "pulumi login --local",
    "register:runner": "bash ./scripts/register-runner.sh",
    "register:runner:auto": "bash ./scripts/register-runner-auto.sh",
    "register:runner:k3s": "bash ./scripts/register-runner-k3s.sh",
    "pause": "docker stop gitlab gitlab-runner",
    "resume": "docker start gitlab gitlab-runner",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pulumi/digitalocean": "^4.51.1",
    "@pulumi/docker": "^4.6.0",
    "@pulumi/kubernetes": "^4.31.0",
    "@pulumi/pulumi": "^3.140.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
