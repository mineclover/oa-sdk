{
  "name": "@oa-sdk/typespec-decorators",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tspMain": "./lib/main.tsp",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run src --maxWorkers 1",
    "test:ci": "pnpm build && vitest run src --maxWorkers 1 --no-file-parallelism",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
