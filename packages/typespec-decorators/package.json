{
  "name": "@oa-sdk/typespec-decorators",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "lib",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "tspMain": "./lib/main.tsp",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },

    "./api": {
      "typespec": "./lib/api.tsp",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./governance": {
      "typespec": "./lib/governance.tsp",
      "types": "./dist/governance.d.ts",
      "default": "./dist/governance.js"
    },
    "./crdt": {
      "typespec": "./lib/crdt.tsp",
      "types": "./dist/crdt.d.ts",
      "default": "./dist/crdt.js"
    },
    "./behavior": {
      "typespec": "./lib/behavior.tsp",
      "types": "./dist/behavior.d.ts",
      "default": "./dist/behavior.js"
    },
    "./storage": {
      "typespec": "./lib/storage.tsp",
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./chunk-stream": {
      "typespec": "./lib/chunk-stream.tsp",
      "types": "./dist/chunk-stream.d.ts",
      "default": "./dist/chunk-stream.js"
    }
  },


  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run src --maxWorkers 1",
    "test:ci": "pnpm build && vitest run src --maxWorkers 1 --no-file-parallelism",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
