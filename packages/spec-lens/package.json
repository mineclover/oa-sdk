{
  "name": "@oa-sdk/spec-lens",
  "version": "0.1.8",
  "description": "OpenAPI spec change history management and observation tool for oa-sdk",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts && cp src/infrastructure/cache/sqlite/schema.sql dist/schema.sql",
    "build:ui": "pnpm --filter @oa-sdk/spec-lens-ui run build",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@oa-sdk/codegen": "workspace:*",
    "@oa-sdk/spec-lens-contract": "workspace:*",
    "@oa-sdk/parser": "workspace:*",
    "hono": "^4.13.13"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
