{
  "name": "@oa-sdk/chunk-stream",
  "version": "0.1.0",
  "description": "High-performance Monomorphic Chunk Stream runtime, memory residency leases, and virtualization engine",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
