{
  "name": "@oa-sdk/peer-server",
  "version": "0.2.0",
  "description": "Authoritative WebMCP Peering, Signaling, Rendezvous, and Local Daemon Server",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay/index.d.ts",
      "import": "./dist/relay/index.js",
      "default": "./dist/relay/index.js"
    },
    "./cloud": {
      "types": "./dist/cloud/index.d.ts",
      "import": "./dist/cloud/index.js",
      "default": "./dist/cloud/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/relay/index.ts src/cloud/index.ts --format esm --dts",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/peer-transport": "workspace:*",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
