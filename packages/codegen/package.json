{
  "name": "@oa-sdk/codegen",
  "version": "0.3.0",
  "description": "Drizzle/TS ↔ OpenAPI bidirectional code generation bridge",
  "private": true,
  "type": "module",
  "bin": {
    "oa-gen": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle/index.js",
      "types": "./dist/drizzle/index.d.ts"
    },
    "./typegen": {
      "import": "./dist/typegen/index.js",
      "types": "./dist/typegen/index.d.ts"
    },
    "./typegen/browser": {
      "import": "./dist/typegen/browser.js",
      "types": "./dist/typegen/browser.d.ts"
    },
    "./spec-lens": {
      "import": "./dist/spec-lens/index.js",
      "types": "./dist/spec-lens/index.d.ts"
    },
    "./apitomy": {
      "import": "./dist/apitomy/index.js",
      "types": "./dist/apitomy/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts src/drizzle/index.ts src/typegen/index.ts src/typegen/browser.ts src/apitomy/index.ts --format esm --dts && tsup src/spec-lens/index.ts --format esm --dts --tsconfig tsconfig.spec-lens.json --out-dir dist/spec-lens --no-splitting",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --maxWorkers 2",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "test:ts7": "vitest run src/__tests__/typegen/compile-check.test.ts --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@oa-sdk/core": "workspace:*",
    "@oa-sdk/openapi-projection-contract": "workspace:*",
    "@oa-sdk/parser": "workspace:*",
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "yaml": "^2.5.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@apitomy/data-models": "^3.1.3",
    "@oa-sdk/mock-server": "workspace:^",
    "@oa-sdk/schemas": "workspace:*",
    "@types/node": "^25.0.0",
    "drizzle-orm": "1.0.0-beta.20",
    "tsup": "^8.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@apitomy/data-models": "^3.1.3",
    "@oa-sdk/client": "workspace:*",
    "@oa-sdk/router": "workspace:*",
    "drizzle-orm": ">=1.0.0-beta.20",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@oa-sdk/router": {
      "optional": true
    },
    "@oa-sdk/client": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@apitomy/data-models": {
      "optional": true
    }
  }
}
