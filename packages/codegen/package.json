{
  "name": "@oa-sdk/codegen",
  "version": "0.8.1",
  "description": "Drizzle/TS ↔ OpenAPI bidirectional code generation bridge",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "oa-gen": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./drizzle": {
      "import": "./dist/drizzle/index.js",
      "types": "./dist/drizzle/index.d.ts"
    },
    "./typegen": {
      "import": "./dist/typegen/index.js",
      "types": "./dist/typegen/index.d.ts"
    },
    "./typegen/browser": {
      "import": "./dist/typegen/browser.js",
      "types": "./dist/typegen/browser.d.ts"
    },
    "./zodgen": {
      "import": "./dist/zodgen/index.js",
      "types": "./dist/zodgen/index.d.ts"
    },
    "./spec-lens": {
      "import": "./dist/spec-lens/index.js",
      "types": "./dist/spec-lens/index.d.ts"
    },
    "./apitomy": {
      "import": "./dist/apitomy/index.js",
      "types": "./dist/apitomy/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts src/drizzle/index.ts src/typegen/index.ts src/typegen/browser.ts src/zodgen/index.ts src/apitomy/index.ts --format esm --dts --external typescript --external @oa-sdk/mock-server --external @oa-sdk/client --external @oa-sdk/router && tsup src/spec-lens/index.ts --format esm --dts --tsconfig tsconfig.spec-lens.json --out-dir dist/spec-lens --no-splitting --external typescript",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run --maxWorkers 2",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "test:ts7": "vitest run src/__tests__/typegen/compile-check.test.ts --maxWorkers 1 --no-file-parallelism",
    "bench:validation": "node --import tsx scripts/bench-validation-engines.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "smoke:pack": "pnpm build && node scripts/package-pack-smoke.mjs"
  },
  "dependencies": {
    "@oa-sdk/ast-sync": "workspace:*",
    "@oa-sdk/core": "workspace:*",
    "@oa-sdk/openapi-projection-contract": "workspace:*",
    "@oa-sdk/parser": "workspace:*",
    "@oa-sdk/surface-ir": "workspace:*",
    "@oa-sdk/typespec-decorators": "workspace:*",
    "@typespec/compiler": "^1.16.0",
    "@typespec/events": "^0.86.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "@typespec/sse": "^0.86.0",
    "@typespec/streams": "^0.86.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  },
  "devDependencies": {
    "@apitomy/data-models": "^3.1.3",
    "@oa-sdk/client": "workspace:*",
    "@oa-sdk/mock-server": "workspace:*",
    "@oa-sdk/router": "workspace:*",
    "@types/node": "^22.0.0",
    "drizzle-orm": "1.0.0-beta.20",
    "tsup": "^8.0.0",
    "typescript": "5.9.3",
    "typia": "^12.0.2",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "@apitomy/data-models": "^3.1.3",
    "drizzle-orm": ">=1.0.0-beta.20",
    "typescript": ">=5.0.0",
    "zod": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "@apitomy/data-models": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
