{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FTP Evaluation v1 draft proposal",
  "x-status": "proposal",
  "description": "Review-only shape derived from FTP src/core/model.ts and evaluation/index.ts. This file has no canonical $id or provider ExactRef.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluationId", "evidenceId", "runId", "criterion", "evaluator", "profile", "requests", "verdict", "coverage", "issues"],
  "properties": {
    "evaluationId": { "$ref": "#/$defs/Identifier" },
    "evidenceId": { "$ref": "#/$defs/Identifier" },
    "runId": { "$ref": "#/$defs/Identifier" },
    "criterion": { "$ref": "#/$defs/ExactRef" },
    "evaluator": { "$ref": "#/$defs/ExactRef" },
    "profile": { "$ref": "#/$defs/Profile" },
    "requests": { "type": "array", "items": { "$ref": "#/$defs/RequestResult" } },
    "verdict": { "$ref": "#/$defs/Verdict" },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["minimum", "applicable", "met"], "properties": { "minimum": { "type": "integer", "minimum": 0 }, "applicable": { "type": "integer", "minimum": 0 }, "met": { "type": "boolean" } } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/EvidenceIssue" } }
  },
  "$defs": {
    "Identifier": { "type": "string", "minLength": 1 },
    "ExactRef": { "type": "object", "additionalProperties": false, "required": ["kind", "namespace", "id", "revision"], "properties": { "kind": { "$ref": "#/$defs/Identifier" }, "namespace": { "$ref": "#/$defs/Identifier" }, "id": { "$ref": "#/$defs/Identifier" }, "revision": { "$ref": "#/$defs/Identifier" } } },
    "Profile": { "type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": { "id": { "$ref": "#/$defs/Identifier" }, "revision": { "$ref": "#/$defs/Identifier" } } },
    "OccurrenceRef": { "type": "object", "additionalProperties": false, "required": ["sourceId", "occurrenceId"], "properties": { "sourceId": { "$ref": "#/$defs/Identifier" }, "occurrenceId": { "$ref": "#/$defs/Identifier" } } },
    "Verdict": { "enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_APPLICABLE", "ERROR"] },
    "CriterionResult": { "type": "object", "additionalProperties": false, "required": ["verdict", "reasonCodes", "witnesses", "evidenceSufficient"], "properties": { "verdict": { "$ref": "#/$defs/Verdict" }, "reasonCodes": { "type": "array", "items": { "$ref": "#/$defs/Identifier" } }, "witnesses": { "type": "array", "items": { "$ref": "#/$defs/OccurrenceRef" } }, "evidenceSufficient": { "type": "boolean" } } },
    "RequestResult": { "type": "object", "additionalProperties": false, "required": ["requestId", "started", "terminal", "order"], "properties": { "requestId": { "$ref": "#/$defs/Identifier" }, "started": { "$ref": "#/$defs/CriterionResult" }, "terminal": { "$ref": "#/$defs/CriterionResult" }, "order": { "$ref": "#/$defs/CriterionResult" } } },
    "Diagnostic": { "type": "object", "additionalProperties": false, "required": ["code", "component", "message"], "properties": { "code": { "$ref": "#/$defs/Identifier" }, "component": { "$ref": "#/$defs/Identifier" }, "message": { "type": "string", "minLength": 1 }, "requestIds": { "type": "array", "items": { "$ref": "#/$defs/Identifier" } } } },
    "EvidenceIssue": { "allOf": [{ "$ref": "#/$defs/Diagnostic" }, { "type": "object", "properties": { "occurrences": { "type": "array", "items": { "$ref": "#/$defs/OccurrenceRef" } } } }] }
  }
}
