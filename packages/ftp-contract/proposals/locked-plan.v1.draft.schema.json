{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FTP LockedPlan v1 draft proposal",
  "x-status": "proposal",
  "description": "Review-only shape derived from FTP src/core/prepare.ts. This file has no canonical $id or provider ExactRef.",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "definitions", "bindings", "resolver", "profiles", "requiredCapabilities", "requireInitializationObservation", "concurrency", "closePolicy", "selection", "applications"],
  "properties": {
    "planId": { "$ref": "#/$defs/Identifier" },
    "definitions": { "type": "array", "items": { "$ref": "#/$defs/Definition" } },
    "bindings": { "type": "array", "items": { "$ref": "#/$defs/Binding" } },
    "resolver": { "$ref": "#/$defs/ExactRef" },
    "profiles": { "type": "array", "items": { "$ref": "#/$defs/Profile" } },
    "requiredCapabilities": { "type": "array", "items": { "$ref": "#/$defs/Identifier" } },
    "requireInitializationObservation": { "type": "boolean" },
    "concurrency": { "enum": ["serial", "concurrent"] },
    "closePolicy": { "$ref": "#/$defs/ClosePolicy" },
    "selection": { "$ref": "#/$defs/Value" },
    "applications": { "type": "array", "items": { "$ref": "#/$defs/Application" } }
  },
  "$defs": {
    "Identifier": { "type": "string", "minLength": 1 },
    "Value": { "anyOf": [{ "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" }, { "type": "array", "items": { "$ref": "#/$defs/Value" } }, { "type": "object", "additionalProperties": { "$ref": "#/$defs/Value" } }] },
    "ExactRef": { "type": "object", "additionalProperties": false, "required": ["kind", "namespace", "id", "revision"], "properties": { "kind": { "$ref": "#/$defs/Identifier" }, "namespace": { "$ref": "#/$defs/Identifier" }, "id": { "$ref": "#/$defs/Identifier" }, "revision": { "$ref": "#/$defs/Identifier" } } },
    "AliasRef": { "type": "object", "additionalProperties": false, "required": ["kind", "scope", "alias"], "properties": { "kind": { "$ref": "#/$defs/Identifier" }, "scope": { "$ref": "#/$defs/Identifier" }, "alias": { "$ref": "#/$defs/Identifier" } } },
    "DefinitionRef": { "anyOf": [{ "$ref": "#/$defs/ExactRef" }, { "$ref": "#/$defs/AliasRef" }] },
    "Definition": { "type": "object", "additionalProperties": false, "required": ["ref", "dependencies", "body"], "properties": { "ref": { "$ref": "#/$defs/ExactRef" }, "dependencies": { "type": "array", "items": { "$ref": "#/$defs/DefinitionRef" } }, "body": { "$ref": "#/$defs/Value" } } },
    "Binding": { "type": "object", "additionalProperties": false, "required": ["requested", "resolved"], "properties": { "requested": { "$ref": "#/$defs/DefinitionRef" }, "resolved": { "$ref": "#/$defs/ExactRef" } } },
    "Profile": { "type": "object", "additionalProperties": false, "required": ["id", "revision"], "properties": { "id": { "$ref": "#/$defs/Identifier" }, "revision": { "$ref": "#/$defs/Identifier" } } },
    "CloseBranch": { "type": "object", "additionalProperties": false, "required": ["inFlight", "budgetMs"], "properties": { "inFlight": { "enum": ["drain", "cancel"] }, "budgetMs": { "type": "number", "minimum": 0 } } },
    "ClosePolicy": { "type": "object", "additionalProperties": false, "required": ["normal", "cancel", "error"], "properties": { "normal": { "$ref": "#/$defs/CloseBranch" }, "cancel": { "$ref": "#/$defs/CloseBranch" }, "error": { "$ref": "#/$defs/CloseBranch" } } },
    "Application": { "type": "object", "additionalProperties": false, "required": ["criterion", "scope", "purpose", "status", "basis"], "properties": { "criterion": { "$ref": "#/$defs/ExactRef" }, "scope": { "$ref": "#/$defs/Identifier" }, "purpose": { "$ref": "#/$defs/Identifier" }, "status": { "enum": ["accepted", "candidate"] }, "basis": { "$ref": "#/$defs/Identifier" } } }
  }
}
