{
  "name": "@oa-sdk/ftp-contract",
  "version": "0.1.0",
  "description": "Canonical oa-sdk exchange declarations consumed by the Functional Test Platform",
  "private": true,
  "type": "module",
  "files": ["dist", "schema", "fixtures", "README.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*",
    "./fixtures/*": "./fixtures/*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && vitest run src --maxWorkers 1",
    "test:ci": "pnpm build && vitest run src --maxWorkers 1 --no-file-parallelism",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
