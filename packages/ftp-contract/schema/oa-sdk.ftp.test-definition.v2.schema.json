{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oa-sdk:ftp:test-definition:2",
  "title": "Functional Test Platform TestDefinition v2",
  "description": "Canonical oa-sdk exchange declaration for an FTP TestDefinition authoring artifact prior to plan locking. Supports ExactRef or AliasRef references and one or more criteria combined by an explicit criterionCombination rule. Every object is closed and no field admits null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "definitionId",
    "target",
    "claim",
    "criteria",
    "method",
    "dataset",
    "criterionCombination"
  ],
  "properties": {
    "definitionId": { "$ref": "#/$defs/Identifier" },
    "target": { "$ref": "#/$defs/DefinitionRef" },
    "claim": { "$ref": "#/$defs/DefinitionRef" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/DefinitionRef" }
    },
    "method": { "$ref": "#/$defs/DefinitionRef" },
    "dataset": { "$ref": "#/$defs/DefinitionRef" },
    "criterionCombination": {
      "enum": ["all", "any"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1
    },
    "ExactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "namespace", "id", "revision"],
      "properties": {
        "kind": { "$ref": "#/$defs/Identifier" },
        "namespace": { "$ref": "#/$defs/Identifier" },
        "id": { "$ref": "#/$defs/Identifier" },
        "revision": { "$ref": "#/$defs/Identifier" }
      }
    },
    "AliasRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scope", "alias"],
      "properties": {
        "kind": { "$ref": "#/$defs/Identifier" },
        "scope": { "$ref": "#/$defs/Identifier" },
        "alias": { "$ref": "#/$defs/Identifier" }
      }
    },
    "DefinitionRef": {
      "oneOf": [
        { "$ref": "#/$defs/ExactRef" },
        { "$ref": "#/$defs/AliasRef" }
      ]
    }
  }
}
