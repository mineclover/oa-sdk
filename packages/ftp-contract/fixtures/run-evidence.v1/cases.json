    { "id": "RE1-REJECT-TEN-DIGIT-FRACTION", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2024-01-01T00:00:00.1234567890Z" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "pattern" },
    { "id": "RE1-REJECT-LEAP-SECOND", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2016-12-31T23:59:60Z" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "pattern" },
    { "id": "RE1-REJECT-OFFSET-TIME", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2024-01-01T09:00:00+09:00" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "pattern" },
    { "id": "RE1-REJECT-NONLEAP-FEB-29", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2023-02-29T00:00:00Z" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "calendar" },
    { "id": "RE1-REJECT-APRIL-31", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2024-04-31T00:00:00Z" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "calendar" },
    { "id": "RE1-REJECT-CENTURY-FEB-29", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "1900-02-29T00:00:00Z" }], "expected": "reject", "at": "/observations/0/receivedAt", "keyword": "calendar" },
    { "id": "RE1-ACCEPT-400-YEAR-FEB-29", "clauses": ["WIRE-02"], "patch": [{ "op": "replace", "path": "/observations/0/receivedAt", "value": "2000-02-29T00:00:00Z" }], "expected": "accept" }
  ]
}
