    { "id": "RE1-REJECT-NULL-EVIDENCE-ID", "clauses": ["T-J02"], "patch": [{ "op": "replace", "path": "/evidenceId", "value": null }], "expected": "reject", "at": "/evidenceId", "keyword": "type" },
    { "id": "RE1-REJECT-NULL-OPTIONAL-RETRY", "clauses": ["T-J02", "WIRE-01"], "patch": [{ "op": "add", "path": "/retryOfRunId", "value": null }], "expected": "reject", "at": "/retryOfRunId", "keyword": "type" },
    { "id": "RE1-REJECT-NULL-ORDER", "clauses": ["T-J02", "WIRE-01"], "patch": [{ "op": "replace", "path": "/observations/0/order", "value": null }], "expected": "reject", "at": "/observations/0/order", "keyword": "type" },
    { "id": "RE1-REJECT-NULL-OBSERVATIONS", "clauses": ["T-J02"], "patch": [{ "op": "replace", "path": "/observations", "value": null }], "expected": "reject", "at": "/observations", "keyword": "type" },
    { "id": "RE1-REJECT-ATTEMPT-WITHOUT-ID", "clauses": ["RUN-01"], "patch": [{ "op": "replace", "path": "/observations/0/unit", "value": "attempt" }], "expected": "reject", "at": "/observations/0", "keyword": "required" },
    { "id": "RE1-REJECT-EMPTY-IDENTIFIER", "clauses": ["T-J02"], "patch": [{ "op": "replace", "path": "/runId", "value": "" }], "expected": "reject", "at": "/runId", "keyword": "minLength" },
    { "id": "RE1-REJECT-UNKNOWN-FIELD", "clauses": ["WIRE-01"], "patch": [{ "op": "add", "path": "/evidenceID", "value": "typo" }], "expected": "reject", "at": "", "keyword": "additionalProperties" },
    { "id": "RE1-REJECT-NONCANONICAL-SEQUENCE", "clauses": ["EVD-03", "WIRE-01"], "patch": [{ "op": "replace", "path": "/observations/0/order/sequence", "value": "01" }], "expected": "reject", "at": "/observations/0/order/sequence", "keyword": "pattern" },
    { "id": "RE1-REJECT-NUMBER-SEQUENCE", "clauses": ["WIRE-01"], "patch": [{ "op": "replace", "path": "/observations/0/order/sequence", "value": 1 }], "expected": "reject", "at": "/observations/0/order/sequence", "keyword": "type" },
    { "id": "RE1-REJECT-UNKNOWN-STATUS", "clauses": ["EVD-04"], "patch": [{ "op": "replace", "path": "/executionStatus", "value": "PASSED" }], "expected": "reject", "at": "/executionStatus", "keyword": "enum" },
