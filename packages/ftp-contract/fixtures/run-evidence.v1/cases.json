      { "op": "replace", "path": "/observations/0/unit", "value": "attempt" },
      { "op": "add", "path": "/observations/0/domainAttemptId", "value": "attempt-1" }
    ], "expected": "accept" },
    { "id": "RE1-ACCEPT-RETRY", "clauses": ["RUN-01"], "patch": [{ "op": "add", "path": "/retryOfRunId", "value": "run-previous" }], "expected": "accept" },
