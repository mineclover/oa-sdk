    { "id": "RE1-REJECT-MISSING-DIAGNOSTICS", "clauses": ["T-J02"], "patch": [{ "op": "remove", "path": "/diagnostics" }], "expected": "reject", "at": "", "keyword": "required" },
    { "id": "RE1-REJECT-MISSING-POINT-REVISION", "clauses": ["T-J02", "REF-02"], "patch": [{ "op": "remove", "path": "/observations/0/point/revision" }], "expected": "reject", "at": "/observations/0/point", "keyword": "required" },
