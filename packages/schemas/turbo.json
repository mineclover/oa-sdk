{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@oa-sdk/codegen#build"],
      "inputs": [
        "src/**",
        "!src/.builder/**",
        "!src/.merged*",
        "typespec/**",
        "scripts/**",
        ".spectral.yaml",
        "redocly.yaml",
        "package.json",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/scripts/schema-typespec-check.ts",
        "$TURBO_ROOT$/scripts/lib/typespec-snapshot-promotion.ts"
      ],
      "outputs": [
        "dist/**",
        "src/.builder/typespec-bundle-report.json",
        "src/.merged.yaml",
        "src/.merged.3.1.yaml",
        "src/.merged.3.1.meta.json"
      ]
    }
  }
}
