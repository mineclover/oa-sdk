{
  "name": "@oa-sdk/schemas",
  "version": "0.1.0",
  "description": "OpenAPI 3.2 modular schema definitions — source of truth",
  "private": true,
  "exports": {
    ".": "./dist/openapi.json",
    "./openapi.yaml": "./dist/openapi.yaml",
    "./openapi.json": "./dist/openapi.json"
  },
  "files": ["dist"],
  "scripts": {
    "split-spec": "node --import tsx scripts/split-spec.ts",
    "merge": "node --import tsx scripts/merge.ts",
    "merge:staging": "PROFILE=staging node --import tsx scripts/merge.ts",
    "merge:production": "PROFILE=production node --import tsx scripts/merge.ts",
    "downgrade:3.1": "node --import tsx scripts/downgrade-3.1.ts",
    "validate:spectral": "spectral lint src/.merged.yaml --ruleset .spectral.yaml",
    "validate:redocly": "redocly lint",
    "validate": "pnpm merge && pnpm downgrade:3.1 && pnpm validate:spectral && pnpm validate:redocly",
    "parity:build": "node ../codegen/dist/cli/index.js build-spec --target src/targets/local-parity-api.yaml --fragments src/fragments --output src/.builder/local-parity-api.yaml --diagnostics src/.builder/local-parity-api.diagnostics.json --collision-report src/.builder/local-parity-api.collisions.json",
    "parity:diff": "node --import tsx ../../scripts/builder-parity-diff.ts src/.merged.yaml src/.builder/local-parity-api.yaml",
    "bundle": "pnpm merge && pnpm downgrade:3.1 && redocly bundle src/.merged.3.1.yaml --output dist/openapi.yaml && redocly bundle src/.merged.3.1.yaml --output dist/openapi.json",
    "preview": "pnpm merge && pnpm downgrade:3.1 && redocly preview-docs src/.merged.3.1.yaml",
    "build": "pnpm merge && pnpm downgrade:3.1",
    "build:full": "pnpm validate && pnpm bundle",
    "upgrade:3.2": "node --import tsx scripts/upgrade-3.2.ts",
    "dev": "nodemon --watch src --ext yaml --ignore src/.merged.yaml --exec 'pnpm bundle'",
    "test": "vitest run",
    "clean": "rm -rf dist src/.merged.yaml src/.merged.3.1.yaml src/.merged.3.1.meta.json"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.0",
    "@stoplight/spectral-cli": "^6.14.0",
    "nodemon": "^3.1.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0",
    "yaml": "^2.5.0"
  }
}
