{
  "name": "@oa-sdk/playground",
  "version": "0.1.0",
  "description": "Integration testing playground — validates schema pipeline and mock server end-to-end",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx examples/full-pipeline.ts",
    "demo:patterns": "tsx examples/demo-typespec-patterns.ts",
    "demo:guards": "tsx examples/demo-standalone-guards.ts",
    "demo:router": "tsx examples/demo-router-contracts.ts",
    "demo:all": "tsx examples/full-pipeline.ts && tsx examples/demo-typespec-patterns.ts && tsx examples/demo-standalone-guards.ts && tsx examples/demo-router-contracts.ts",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "test:watch": "vitest",
    "schema:validate": "pnpm --filter @oa-sdk/schemas run validate",
    "schema:preview": "pnpm --filter @oa-sdk/schemas run preview",
    "mock:start": "corepack pnpm --dir ../.. mock:start",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@oa-sdk/client": "workspace:*",
    "@oa-sdk/codegen": "workspace:*",
    "@oa-sdk/mock-server": "workspace:*",
    "@oa-sdk/openapi-projection-contract": "workspace:*",
    "@oa-sdk/parser": "workspace:*",
    "@oa-sdk/personas": "workspace:*",
    "@oa-sdk/router": "workspace:*",
    "@oa-sdk/schemas": "workspace:*",
    "yaml": "^2.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hono": "^4.12.14",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.4"
  }
}
