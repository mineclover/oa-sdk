{
  "name": "@oa-sdk/preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "msw init ./public --save",
    "dev": "vite",
    "build": "vite build",
    "smoke:browser-runtime": "pnpm build && node scripts/browser-runtime-smoke.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers 1 --no-file-parallelism",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@oa-sdk/client": "workspace:*",
    "@oa-sdk/codegen": "workspace:*",
    "@oa-sdk/mock-server": "workspace:*",
    "@oa-sdk/parser": "workspace:*",
    "@oa-sdk/router": "workspace:*",
    "msw": "^2.13.4",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
