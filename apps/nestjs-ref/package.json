{
  "name": "@oa-sdk/nestjs-ref",
  "version": "0.1.0",
  "description": "NestJS Swagger → oa-sdk governance reference implementation",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "export:openapi": "ts-node scripts/export-openapi.ts",
    "governance:all": "bash scripts/openapi-governance.sh all",
    "governance:collect": "bash scripts/openapi-governance.sh collect",
    "governance:check": "bash scripts/openapi-governance.sh check",
    "governance:review": "bash scripts/openapi-governance.sh review",
    "governance:review-bundle": "bash scripts/openapi-governance.sh review-bundle",
    "governance:inventory": "bash scripts/openapi-governance.sh inventory",
    "governance:validate-upgraded": "bash scripts/openapi-governance.sh validate-upgraded",
    "governance:drift": "bash scripts/openapi-governance.sh drift",
    "governance:update-baseline": "bash scripts/openapi-governance.sh update-baseline",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "js-yaml": "^4.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  }
}
