digraph "breaking-impact-analysis" {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fillcolor="#f8fafc", fontname="sans-serif"];
  edge [fontname="sans-serif", fontsize=10];
  __start [shape=circle, label="", style=filled, fillcolor=black, width=0.2];
  __start -> "timeline" [label="START"];
  "timeline" -> "diff" [label="REQUEST_DIFF\n[require-diff-pair]"];
  "diff" -> "diff" [label="FILTER_BREAKING_CHANGES"];
  "diff" -> "graph" [label="SELECT_FRAGMENT_SYMBOL\n[require-symbol-id]"];
  "graph" -> "graph" [label="COMPLETE_GOAL"];
  "graph" -> "diff" [label="REQUEST_DIFF\n[require-diff-pair]"];
  __end_impact-assessed [shape=doublecircle, label="", style=filled, fillcolor=black, width=0.2];
  "graph" -> __end_impact-assessed [label="GOAL: impact-assessed"];
}