{
  "version": 1,
  "updatedAt": "2026-04-17",
  "description": "Feature-to-test mapping for oa-sdk. Each feature lists representative automated coverage and the commands that maintain it.",
  "features": [
    {
      "id": "core-utilities",
      "name": "Core utilities",
      "category": "foundation",
      "package": "@oa-sdk/core",
      "description": "Shared string, format, response, and codegen helpers.",
      "capabilities": [
        "case conversion",
        "response status selection",
        "generated TypeScript formatting",
        "HTTP response utilities"
      ],
      "testPaths": [
        "packages/core/src/__tests__/*.test.ts"
      ],
      "commands": [
        "pnpm --filter @oa-sdk/core test",
        "pnpm --filter @oa-sdk/core typecheck"
      ]
    },
    {
      "id": "oas32-parser-ir",
      "name": "OpenAPI 3.2 parser and IR",
      "category": "parser",
      "package": "@oa-sdk/parser",
      "description": "OAS 3.2 parsing, route/schema indexing, query helpers, validation, and linting.",
      "capabilities": [
        "parseDocument",
        "loadSchema",
        "matchRoute",
        "lintDocument",
        "validateDocument",
        "query helpers"
      ],
      "testPaths": [
        "packages/parser/src/__tests__/parse-document.test.ts",
        "packages/parser/src/__tests__/parse-edge-cases.test.ts",
        "packages/parser/src/__tests__/schema-loader.test.ts",
        "packages/parser/src/__tests__/lint*.test.ts",
        "packages/parser/src/__tests__/validate.test.ts",
        "packages/parser/src/__tests__/query.test.ts",
        "packages/parser/src/__tests__/server.test.ts",
        "packages/parser/src/__tests__/tags.test.ts"
      ],
      "commands": [
        "pnpm --filter @oa-sdk/parser test",
        "pnpm --filter @oa-sdk/parser typecheck"
      ]
    },
