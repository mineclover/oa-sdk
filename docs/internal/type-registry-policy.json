{
  "schemaVersion": "oa-sdk.type-registry-policy.v1",
  "owner": "OA SDK maintainers",
  "baselinePath": "docs/internal/type-registry-baseline.json",
  "outputDirectory": ".oa-sdk/type-registry",
  "workspaceRoots": [
    "apps",
    "packages"
  ],
  "sourceExtensions": [
    ".cts",
    ".d.ts",
    ".mts",
    ".ts",
    ".tsx"
  ],
  "excludePatterns": [
    "**/.builder/**",
    "**/__tests__/**",
    "**/dist/**",
    "**/fixtures/**",
    "**/node_modules/**",
    "apps/nestjs-ref/src/generated/**",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "generatedPatterns": [
    "**/generated/**",
    "**/*.generated.ts",
    "**/*.generated.tsx"
  ],
  "boundaryBudgets": [
    {
      "rule": "boundary:any",
      "maximum": 183,
      "owner": "OA SDK maintainers",
      "remediation": "Replace explicit any with a narrow generic, unknown plus validation, or a modeled protocol type."
    },
    {
      "rule": "boundary:double-assertion",
      "maximum": 38,
      "owner": "OA SDK maintainers",
      "remediation": "Remove the double assertion or validate the value before crossing the boundary."
    },
    {
      "rule": "boundary:unvalidated-deserialize",
      "maximum": 121,
      "owner": "OA SDK maintainers",
      "remediation": "Parse deserialized data through a named schema validator before treating it as a domain type."
    }
  ],
  "allowlist": []
}
