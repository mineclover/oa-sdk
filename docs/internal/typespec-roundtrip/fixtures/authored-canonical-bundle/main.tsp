@tagMetadata("health", #{ description: "서버 상태 확인" })
namespace OaSdkApi;

model bearerAuth is BearerAuth;

@doc("Action role binding에 쓰는 active Entity UUID")
@format("uuid")
scalar ActiveEntityId extends string;

@doc("사용자 PII bulk export 요청. data-eng ETL surface이며 non-admin\nperspective에서는 pseudonymization이 필수입니다.\n")
model AdminUsersExportRequest {
  format?: "json" | "csv" = "json";
  pseudonymize?: boolean = true;
  ...Record<never>;
}

@doc("현재 logical time에서 duration만큼 전진하는 요청")
model AdvanceByLogicalDuration {
  kind: "by-duration";
  duration: string;
  ...Record<never>;
}

@doc("현재 logical time에서 target instant까지 전진하는 요청")
model AdvanceToLogicalTime {
  kind: "to-logical-time";
  targetLogicalTime: string;
  ...Record<never>;
}

@doc("사용자 + 토큰 페어 — 가입/로그인 응답 단위")
@example(#{ user: #{ id: "00000000-0000-0000-0000-000000000001", email: "alice@example.com", name: "Alice", role: "user", createdAt: utcDateTime.fromISO("2024-01-01T00:00:00.000Z") }, tokens: #{ accessToken: "eyJhbGciOi...example", refreshToken: "rt_example_0001", tokenType: "Bearer", expiresIn: 3600 } })
model AuthSession {
  user: User;
  tokens: TokenPair;
}

@doc("현재 실행 중인 빌드 정보")
@example(#{ version: "0.1.0", gitSha: "a0ca911", builtAt: utcDateTime.fromISO("2026-05-04T00:00:00.000Z") })
model BuildInfo {
  @doc("semver 또는 빌드 식별 라벨")
  version: string;
  @doc("커밋 해시")
  @minLength(7)
  gitSha: string;
  builtAt: utcDateTime;
}

@doc("비밀번호 변경 요청")
model ChangePasswordRequest {
  @minLength(1)
  currentPassword: string;
  @doc("최소 8자 이상")
  @minLength(8)
  newPassword: string;
}

@doc("사용자 생성 요청")
model CreateUserRequest {
  @format("email")
  email: string;
  @minLength(1)
  @maxLength(100)
  name: string;
  @doc("최소 8자 이상")
  @minLength(8)
  password: string;
}

@doc("새 World bootstrap 요청. 생성 뒤 ModelRef와 ExecutionProfileRef는 normal Stimulus로 바꿀 수 없습니다.")
model CreateWorldRequest {
  @format("uuid")
  worldId: string;
  modelRef: ModelRef;
  executionProfile: ExecutionProfileRef;
  @doc("모델이 해석하는 초기 scenario/configuration reference")
  @minLength(1)
  bootstrapSpecRef: string;
  @doc("선택적 replay seed material. 없으면 provider가 생성한 값을 WorldControlState에 고정합니다.")
  runSeedMaterial?: string;
}

model DependencyStatus {
  name: string;
  status: "ok" | "degraded" | "down";
  @minValue(0)
  latencyMs?: integer;
  message?: string;
}

@doc("표준 에러 응답 스키마")
@example(#{ code: "NOT_FOUND", message: "요청한 리소스를 찾을 수 없습니다" })
model Error {
  @doc("머신 리더블 에러 코드 (페르소나 시나리오의 expected assertion 단위)")
  @example("NOT_FOUND")
  code: "BAD_REQUEST" | "UNAUTHORIZED" | "FORBIDDEN" | "NOT_FOUND" | "CONFLICT" | "SCHEMA_VALIDATION_FAILED" | "RATE_LIMITED" | "INTERNAL_SERVER_ERROR" | "SERVICE_UNAVAILABLE";
  @doc("사람이 읽을 수 있는 에러 설명")
  @example("요청한 리소스를 찾을 수 없습니다")
  message: string;
  details?: ValidationError[];
  _meta?: ErrorMeta;
}

@doc("World에 고정할 실행 provider 조합의 정확한 식별자")
model ExecutionProfileRef {
  @minLength(1)
  profileId: string;
  @minLength(1)
  version: string;
  @minLength(1)
  semanticFingerprint: string;
}

@doc("선택 가능한 실행 profile의 공개 요약")
model ExecutionProfileSummary {
  profile: ExecutionProfileRef;
  persistenceRecovery: "volatile" | "snapshot-journal" | "durable-outbox";
  numericSemantics: "fixed-decimal" | "rational" | "strict-binary-float";
  decisionRandom: "counter-derived" | "seeded-stream";
  commitIsolation: "single-writer" | "optimistic-revision-cas" | "serializable-transaction";
  conformanceProfiles: string[];
}

@doc("export job receipt. 이 계약의 POST 응답은 queued 상태만 반환하며, 이후 상태 전이와 downloadUrl 전달 방식은 runtime 계약이 별도로 정의합니다.")
@example(#{ jobId: "00000000-0000-0000-0000-000000000200", status: "queued", requestedAt: utcDateTime.fromISO("2026-05-04T00:00:00.000Z") })
model ExportJob {
  @format("uuid")
  jobId: string;
  status: "queued" | "running" | "ready" | "failed";
  requestedAt: utcDateTime;
  @doc("status가 ready일 때만 제공")
  @format("uri")
  downloadUrl?: string;
}

@doc("데이터 export 요청")
model ExportRequest {
  format?: "json" | "csv" = "json";
}

@doc("비밀번호 재설정 토큰 발송 요청")
model ForgotPasswordRequest {
  @format("email")
  email: string;
}

@doc("SSE 헬스 이벤트 payload")
model HealthEvent {
  @doc("관측된 서버 상태")
  status: "ok" | "degraded" | "down";
  @doc("이벤트 발생 시각")
  timestamp: utcDateTime;
}

alias HealthEvents = HealthEvent;

@example(#{ status: "ok", timestamp: utcDateTime.fromISO("2026-04-04T00:00:00.000Z") })
model HealthStatus {
  status: "ok";
  timestamp: utcDateTime;
}

@example(#{ items: #[#{ profile: #{ profileId: "deterministic-local", version: "1.0.0", semanticFingerprint: "sha256:execution-profile" }, persistenceRecovery: "durable-outbox", numericSemantics: "fixed-decimal", decisionRandom: "counter-derived", commitIsolation: "serializable-transaction", conformanceProfiles: #["replay-safe", "single-writer"] }] })
model ListExecutionProfilesResponseBody {
  items: ExecutionProfileSummary[];
}

@doc("로그인 요청")
model LoginRequest {
  @format("email")
  email: string;
  @minLength(1)
  password: string;
}

@doc("게시된 World Model artifact의 정확한 식별자")
model ModelRef {
  @minLength(1)
  modelId: string;
  @minLength(1)
  version: string;
  @minLength(1)
  semanticFingerprint: string;
}

@doc("온보딩 가이드 체크리스트")
@example(#{ items: #[#{ id: "complete-profile", title: "프로필 작성", completed: false }] })
model OnboardingChecklist {
  items: OnboardingItem[];
}

model OnboardingItem {
  id: string;
  title: string;
  completed: boolean;
  hint?: string;
}

@doc("같은 revision에서 함께 읽어야 하는 semantic projection bundle")
@example(#{ worldId: "00000000-0000-0000-0000-000000000401", modelRef: #{ modelId: "city-sim", version: "2026.08", semanticFingerprint: "sha256:city-model" }, sourceRevision: 42, bundleId: "world-overview", status: "complete", projections: #[#{ projectionId: "population-summary", value: #{ population: 1250 } }] })
model ProjectionBundleEnvelope {
  @format("uuid")
  worldId: string;
  modelRef: ModelRef;
  @minValue(0)
  sourceRevision: int64;
  @minLength(1)
  bundleId: string;
  status: "complete" | "incomplete" | "stale";
  projections: ProjectionBundleItem[];
}

@doc("Projection bundle의 outer world/model/revision context를 상속하는 item")
model ProjectionBundleItem {
  @minLength(1)
  projectionId: string;
  @doc("PublishedModel이 선언한 projection result의 typed JSON representation")
  value: unknown;
  ...Record<never>;
}

@doc("특정 source revision에서 materialize한 semantic projection")
@example(#{ worldId: "00000000-0000-0000-0000-000000000401", modelRef: #{ modelId: "city-sim", version: "2026.08", semanticFingerprint: "sha256:city-model" }, sourceRevision: 42, projectionId: "population-summary", value: #{ population: 1250 } })
model ProjectionEnvelope {
  @format("uuid")
  worldId: string;
  modelRef: ModelRef;
  @minValue(0)
  sourceRevision: int64;
  @minLength(1)
  projectionId: string;
  @doc("PublishedModel이 선언한 projection result의 typed JSON representation")
  value: unknown;
}

@doc("공개 프로필 — PII 비포함 (email/createdAt 제외)")
@example(#{ id: "00000000-0000-0000-0000-000000000001", name: "Alice", role: "user" })
model PublicUserProfile {
  @format("uuid")
  id: string;
  @minLength(1)
  @maxLength(100)
  name: string;
  role: "admin" | "user" | "guest";
}

@doc("site-admin 사용자 hard purge 요청. deleteUser와 별도의 권한 및 감사 절차를 적용합니다.")
model PurgeUserRequest {
  @doc("영구 삭제 감사 사유")
  @minLength(1)
  @maxLength(1000)
  reason: string;
  @doc("legal hold 예외 승인 여부")
  legalHoldOverride?: boolean = false;
  ...Record<never>;
}

@doc("readiness probe 결과 — 의존 시스템 검증 포함")
@example(#{ status: "ready", timestamp: utcDateTime.fromISO("2026-05-04T00:00:00.000Z"), dependencies: #[#{ name: "postgres", status: "ok" }] })
model ReadinessReport {
  status: "ready" | "not-ready";
  timestamp: utcDateTime;
  dependencies: DependencyStatus[];
}

@doc("토큰 갱신 요청")
model RefreshRequest {
  @minLength(1)
  refreshToken: string;
}

@doc("회원가입 요청")
model RegisterRequest {
  @format("email")
  email: string;
  @minLength(1)
  @maxLength(100)
  name: string;
  @doc("최소 8자 이상")
  @minLength(8)
  password: string;
}

@doc("신고 단건")
@example(#{ id: "00000000-0000-0000-0000-000000000300", targetUserId: "00000000-0000-0000-0000-000000000001", reporterUserId: "00000000-0000-0000-0000-000000000002", reason: "harassment", status: "open", createdAt: utcDateTime.fromISO("2026-05-04T00:00:00.000Z") })
model Report {
  @format("uuid")
  id: string;
  @format("uuid")
  targetUserId: string;
  @format("uuid")
  reporterUserId: string;
  reason: "spam" | "harassment" | "hate-speech" | "fraud" | "impersonation" | "other";
  details?: string;
  status: "open" | "under-review" | "resolved" | "dismissed";
  createdAt: utcDateTime;
  resolvedAt?: utcDateTime;
}

@doc("신고 요청 본문")
model ReportRequest {
  reason: "spam" | "harassment" | "hate-speech" | "fraud" | "impersonation" | "other";
  @maxLength(1000)
  details?: string;
}

@doc("비밀번호 재설정 요청")
model ResetPasswordRequest {
  @minLength(1)
  token: string;
  @doc("최소 8자 이상")
  @minLength(8)
  newPassword: string;
}

@doc("역할 변경 이력 단건")
model RoleChangeEvent {
  @format("uuid")
  id: string;
  changedAt: utcDateTime;
  previousRole: "admin" | "user" | "guest";
  newRole: "admin" | "user" | "guest";
  @doc("변경을 수행한 admin의 UUID")
  @format("uuid")
  changedBy: string;
  reason?: string;
}

@doc("Agenda가 받아들인 Stimulus. 이 응답은 Transaction commit 성공을 뜻하지 않습니다.")
@example(#{ stimulusId: "00000000-0000-0000-0000-000000000402", worldId: "00000000-0000-0000-0000-000000000401", status: "accepted", acceptedAtRevision: 42, acceptedLogicalTime: "2030-01-01T12:00:00Z" })
model StimulusAccepted {
  @format("uuid")
  stimulusId: string;
  @format("uuid")
  worldId: string;
  status: "accepted" | "duplicate";
  @minValue(0)
  acceptedAtRevision: int64;
  acceptedLogicalTime: string;
}

@doc("외부 Action 의도를 SimulationAgenda에 넣기 위한 typed envelope. role/parameter의 상세 contract는 World의 PublishedModel이 검증합니다.")
model SubmitActionRequest {
  @format("uuid")
  stimulusId: string;
  @minLength(1)
  actionTypeId: string;
  @doc("ActionRoleDefinition stable ID에서 active Entity UUID로의 binding")
  roles: Record<ActiveEntityId>;
  @doc("ActionParameterDefinition stable ID에서 typed JSON value로의 binding")
  parameters?: Record<unknown>;
  correlationId?: string;
  causationId?: string;
}

@doc("TimeAdvanceRequest envelope. 한 요청은 target instant 또는 duration 중 하나만 가집니다.")
model SubmitTimeAdvanceRequest {
  @format("uuid")
  stimulusId: string;
  request: AdvanceToLogicalTime | AdvanceByLogicalDuration;
  correlationId?: string;
  causationId?: string;
}

@doc("access/refresh 토큰 페어")
@example(#{ accessToken: "eyJhbGciOi...example", refreshToken: "rt_example_0001", tokenType: "Bearer", expiresIn: 3600 })
model TokenPair {
  @doc("bearerAuth 헤더에 사용할 JWT")
  accessToken: string;
  @doc("/auth/refresh 호출에 사용할 장기 토큰")
  refreshToken: string;
  tokenType: "Bearer";
  @doc("accessToken 만료까지 남은 초")
  @minValue(1)
  expiresIn: integer;
}

@doc("셀프 프로필 수정 — name만 허용하며 role과 알 수 없는 필드는 포함할 수 없음")
model UpdateMeRequest {
  @minLength(1)
  @maxLength(100)
  name: string;
  ...Record<never>;
}

@doc("사용자 수정 요청 (부분 업데이트 — 모든 필드 optional)")
model UpdateUserRequest {
  @minLength(1)
  @maxLength(100)
  name?: string;
  role?: "admin" | "user" | "guest";
}

@doc("사용자 정보")
@example(#{ id: "00000000-0000-0000-0000-000000000001", email: "alice@example.com", name: "Alice", role: "user", createdAt: utcDateTime.fromISO("2024-01-01T00:00:00.000Z") })
model User {
  @format("uuid")
  id: string;
  @format("email")
  email: string;
  @minLength(1)
  @maxLength(100)
  name: string;
  role: "admin" | "user" | "guest";
  createdAt: utcDateTime;
}

@doc("필드 수준 유효성 검사 에러")
model ValidationError {
  @example("/body/email")
  path: string;
  @example("must match format 'email'")
  message: string;
  @doc("수신값의 안전한 진단 요약. 원문 문자열·객체·배열·토큰·비밀번호는 반환하지 않습니다.")
  @example(#{ type: "string", length: 12 })
  received?: ValidationReceivedStringSummary | ValidationReceivedArraySummary | ValidationReceivedObjectSummary | ValidationReceivedScalarSummary;
  @example("string with format 'email'")
  expected?: string;
}

@doc("배열 수신값의 content-free 진단 요약")
model ValidationReceivedArraySummary {
  type: "array";
  @minValue(0)
  @maxValue(9007199254740991)
  count: int64;
  ...Record<never>;
}

@doc("객체 수신값의 content-free 진단 요약")
model ValidationReceivedObjectSummary {
  type: "object";
  @minValue(0)
  @maxValue(9007199254740991)
  count: int64;
  ...Record<never>;
}

@doc("내용을 포함하지 않는 scalar 수신값의 진단 요약")
model ValidationReceivedScalarSummary {
  type: "number" | "boolean" | "bigint" | "symbol" | "function" | "null" | "undefined";
  ...Record<never>;
}

@doc("문자열 수신값의 content-free 진단 요약")
model ValidationReceivedStringSummary {
  type: "string";
  @minValue(0)
  @maxValue(9007199254740991)
  length: int64;
  ...Record<never>;
}

@doc("World의 public control head. Domain Property와 raw StateObject graph는 포함하지 않습니다.")
@example(#{ worldId: "00000000-0000-0000-0000-000000000401", modelRef: #{ modelId: "city-sim", version: "2026.08", semanticFingerprint: "sha256:city-model" }, executionProfile: #{ profileId: "deterministic-local", version: "1.0.0", semanticFingerprint: "sha256:execution-profile" }, revision: 42, logicalTime: "2030-01-01T12:00:00Z", lifecycle: "active" })
model WorldHead {
  @format("uuid")
  worldId: string;
  modelRef: ModelRef;
  executionProfile: ExecutionProfileRef;
  @minValue(0)
  revision: int64;
  @doc("모델이 선언한 형식으로 직렬화한 현재 logical time")
  logicalTime: string;
  lifecycle: "created" | "active" | "inactive" | "ended";
}

model ErrorMeta {
  operationId?: string;
  @format("uuid")
  requestId?: string;
}

@events
union StreamHealthEvents200Events {
  health: HealthEvent;
}

@example(#{ items: #[#{ id: "00000000-0000-0000-0000-000000000100", changedAt: utcDateTime.fromISO("2026-04-01T00:00:00.000Z"), previousRole: "user", newRole: "admin", changedBy: "00000000-0000-0000-0000-000000000099", reason: "권한 위임" }], total: 1 })
