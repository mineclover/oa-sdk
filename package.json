{
  "name": "oa-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI 3.2 management monorepo — modular schemas, codegen bridge, mock server",
  "engines": {
    "node": ">=24.0.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "corepack pnpm build:core",
    "build:all": "turbo run build",
    "build:core": "turbo run build --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/spec-lens-contract --filter=@oa-sdk/typespec-decorators --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens --filter=@oa-sdk/ast-sync --filter=@oa-sdk/tools --filter=@oa-sdk/surface-ir",
    "build:downstream": "turbo run build --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server --filter=@oa-sdk/chunk-stream --filter=@oa-sdk/chunk-stream-crdt --filter=@oa-sdk/chunk-stream-ui --filter=@oa-sdk/chunk-stream-timeseries --filter=@oa-sdk/chunk-stream-react --filter=@oa-sdk/peer-transport --filter=@oa-sdk/peer-server --filter=@oa-sdk/collab-workspace --filter=@oa-sdk/mcp-mesh",
    "build:maintenance": "turbo run build --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock --filter=@oa-sdk/logical-erd-contract --filter=@oa-sdk/typespec-erd --filter=@oa-sdk/typespec-tooling",
    "build:internal": "turbo run build --filter=@oa-sdk/nestjs-ref --filter=@oa-sdk/playground --filter=@oa-sdk/preview --filter=@oa-sdk/spec-lens-ui",
    "dev": "turbo run dev --parallel",
    "test": "corepack pnpm test:core",
    "test:all": "turbo run test --concurrency=1",
    "test:e2e": "vitest run tests/e2e/typespec-ecosystem",
    "test:core": "turbo run test --concurrency=1 --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/spec-lens-contract --filter=@oa-sdk/typespec-decorators --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens --filter=@oa-sdk/ast-sync --filter=@oa-sdk/tools --filter=@oa-sdk/surface-ir",
    "test:core:ci": "turbo run test:ci --concurrency=1 --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/spec-lens-contract --filter=@oa-sdk/typespec-decorators --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens --filter=@oa-sdk/ast-sync --filter=@oa-sdk/tools --filter=@oa-sdk/surface-ir",
    "test:downstream": "turbo run test --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server --filter=@oa-sdk/chunk-stream --filter=@oa-sdk/chunk-stream-crdt --filter=@oa-sdk/chunk-stream-ui --filter=@oa-sdk/chunk-stream-timeseries --filter=@oa-sdk/chunk-stream-react --filter=@oa-sdk/peer-transport --filter=@oa-sdk/peer-server --filter=@oa-sdk/collab-workspace --filter=@oa-sdk/mcp-mesh",
    "test:downstream:ci": "turbo run test:ci --concurrency=1 --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server --filter=@oa-sdk/chunk-stream --filter=@oa-sdk/chunk-stream-crdt --filter=@oa-sdk/chunk-stream-ui --filter=@oa-sdk/chunk-stream-timeseries --filter=@oa-sdk/chunk-stream-react --filter=@oa-sdk/peer-transport --filter=@oa-sdk/peer-server --filter=@oa-sdk/collab-workspace --filter=@oa-sdk/mcp-mesh",
    "test:maintenance": "turbo run test --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock --filter=@oa-sdk/logical-erd-contract --filter=@oa-sdk/typespec-erd --filter=@oa-sdk/typespec-tooling",
    "test:maintenance:ci": "turbo run test:ci --concurrency=1 --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock --filter=@oa-sdk/logical-erd-contract --filter=@oa-sdk/typespec-erd --filter=@oa-sdk/typespec-tooling",
    "test:internal": "turbo run test --filter=@oa-sdk/playground --filter=@oa-sdk/spec-lens-ui",
    "test:internal:ci": "turbo run test:ci --concurrency=1 --filter=@oa-sdk/playground --filter=@oa-sdk/spec-lens-ui",
    "typecheck": "corepack pnpm typecheck:core",
    "check:ts5": "corepack pnpm typecheck:all",
    "check:ts7": "node --import tsx scripts/check-ts7.ts && corepack pnpm --filter @oa-sdk/codegen run test:ts7",
    "typecheck:all": "turbo run typecheck",
    "typecheck:core": "turbo run typecheck --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/spec-lens-contract --filter=@oa-sdk/typespec-decorators --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens --filter=@oa-sdk/ast-sync --filter=@oa-sdk/tools --filter=@oa-sdk/surface-ir",
    "typecheck:downstream": "turbo run typecheck --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server --filter=@oa-sdk/chunk-stream --filter=@oa-sdk/chunk-stream-crdt --filter=@oa-sdk/chunk-stream-ui --filter=@oa-sdk/chunk-stream-timeseries --filter=@oa-sdk/chunk-stream-react --filter=@oa-sdk/peer-transport --filter=@oa-sdk/peer-server --filter=@oa-sdk/collab-workspace --filter=@oa-sdk/mcp-mesh",
    "typecheck:maintenance": "turbo run typecheck --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock --filter=@oa-sdk/logical-erd-contract --filter=@oa-sdk/typespec-erd --filter=@oa-sdk/typespec-tooling",
    "typecheck:internal": "turbo run typecheck --filter=@oa-sdk/nestjs-ref --filter=@oa-sdk/playground --filter=@oa-sdk/preview --filter=@oa-sdk/spec-lens-ui",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "corepack pnpm release:export",
    "release:preflight": "node --import tsx scripts/release-preflight.ts",
    "test:release-preflight": "node --import tsx scripts/test-release-preflight.ts",
    "schema:validate": "corepack pnpm schema:prepare-openapi && corepack pnpm --filter @oa-sdk/schemas run validate && node packages/codegen/dist/cli/index.js validate --spec packages/schemas/src/.merged.yaml --require-32",
    "schema:validate:openapi": "corepack pnpm --filter @oa-sdk/schemas run validate:openapi && node packages/codegen/dist/cli/index.js validate --spec packages/schemas/src/.merged.yaml --require-32",
    "schema:prepare-openapi": "corepack pnpm --filter @oa-sdk/core build && corepack pnpm --filter @oa-sdk/openapi-projection-contract build && corepack pnpm --filter @oa-sdk/parser build && corepack pnpm --filter @oa-sdk/codegen build",
    "schema:build:openapi": "corepack pnpm --filter @oa-sdk/schemas run build:merged",
    "schema:build:openapi:staging": "corepack pnpm --filter @oa-sdk/schemas run build:merged:staging",
    "schema:build:openapi:production": "corepack pnpm --filter @oa-sdk/schemas run build:merged:production",
    "schema:project-typespec": "corepack pnpm --filter @oa-sdk/typespec-decorators build && node --import tsx scripts/schema-typespec-project.ts",
    "schema:project-typespec:local": "pnpm schema:project-typespec -- --profile local",
    "schema:project-typespec:staging": "pnpm schema:project-typespec -- --profile staging",
    "schema:project-typespec:production": "pnpm schema:project-typespec -- --profile production",
    "schema:codegen-preflight": "node --import tsx scripts/ensure-codegen-cli.ts",
    "schema:bundle": "corepack pnpm --filter @oa-sdk/schemas run bundle",
    "schema:bundle:openapi": "corepack pnpm --filter @oa-sdk/schemas run bundle:openapi",
    "schema:typespec-check": "corepack pnpm --filter @oa-sdk/typespec-decorators build && node --import tsx scripts/schema-typespec-check.ts",
    "schema:typespec-provenance-check": "corepack pnpm --filter @oa-sdk/typespec-decorators build && node --import tsx scripts/check-typespec-provenance.ts",
    "schema:check-contract-version": "node --import tsx scripts/check-contract-version.ts",
    "schema:pipeline": "node --import tsx scripts/schema-transparency-check.ts",
    "schema:approve-typespec-reference": "corepack pnpm --filter @oa-sdk/typespec-decorators build && node --import tsx scripts/schema-approve-typespec-reference.ts",
    "schema:rollback-check": "node --import tsx scripts/schema-rollback-check.ts",
    "test:schema-rollback-check": "node --import tsx scripts/test-schema-rollback-check.ts",
    "schema:downstream-check": "node --import tsx scripts/schema-typespec-downstream-check.ts",
    "graph-db:downstream-check": "node --import tsx scripts/check-bun-graph-db-downstream.ts",
    "schema:preview": "corepack pnpm --filter @oa-sdk/schemas run preview",
    "schema:preview:openapi": "corepack pnpm --filter @oa-sdk/schemas run preview:openapi",
    "personas:check": "corepack pnpm --filter @oa-sdk/personas run check",
    "personas:coverage": "corepack pnpm --filter @oa-sdk/personas run coverage",
    "personas:test": "corepack pnpm --filter @oa-sdk/personas run test",
    "mock:start": "corepack pnpm --filter @oa-sdk/mock-server run build && node packages/mock-server/dist/cli/index.js --spec packages/schemas/src/.merged.yaml",
    "mock:dev": "corepack pnpm --filter @oa-sdk/mock-server run dev",
    "demo": "corepack pnpm --filter playground run demo",
    "demo:dpm": "corepack pnpm --filter @oa-sdk/dpm run demo",
    "demo:dpm:storage": "corepack pnpm --filter @oa-sdk/dpm run demo:storage",
    "demo:dpm:profile": "corepack pnpm --filter @oa-sdk/dpm run demo:profile",
    "build:scripts": "tsup scripts/spec-diff.ts --format esm --outDir scripts/dist --clean --platform node --external execa --external yaml --external @oa-sdk/mock-server",
    "check:api-index": "node --import tsx scripts/check-api-index.ts",
    "test:api-index": "node --import tsx scripts/test-api-index.ts",
    "check:cli-spec": "node --import tsx scripts/check-cli-spec.ts",
    "check:spec-governance": "node --import tsx scripts/check-spec-governance.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts",
    "test:docs-gates": "node --import tsx scripts/test-validation-gates.ts",
    "check:feature-tests": "node --import tsx scripts/check-feature-test-matrix.ts",
    "check:codegen-boundaries": "node --import tsx scripts/check-codegen-boundaries.ts",
    "type-registry:check": "node --import tsx scripts/type-registry-governance.ts",
    "type-registry:write": "node --import tsx scripts/type-registry-governance.ts --write",
    "test:type-registry-governance": "node --import tsx scripts/test-type-registry-governance.ts",
    "check:dpm-surface": "corepack pnpm --filter @oa-sdk/dpm run smoke:subpaths && corepack pnpm --filter @oa-sdk/dpm run smoke:extraction && corepack pnpm --filter @oa-sdk/dpm run smoke:consumer-workflow && corepack pnpm --filter @oa-sdk/dpm run smoke:pack",
    "check:release-policy": "node --import tsx scripts/check-release-policy.ts && corepack pnpm test:release-policy && corepack pnpm test:release-preflight",
    "test:release-policy": "node --import tsx scripts/test-release-policy.ts",
    "check:workspace-scope": "pnpm check:release-policy",
    "spec:diff": "node scripts/dist/spec-diff.js",
    "typespec:roundtrip": "node --import tsx scripts/typespec-roundtrip.ts",
    "typespec:bundle-check": "node --import tsx scripts/typespec-bundle-check.ts",
    "typespec:sidecar-to-extensions": "node --import tsx scripts/typespec-sidecar-to-extensions.ts",
    "typespec:create-canonical-fixture": "node --import tsx scripts/typespec-create-authored-canonical-fixture.ts",
    "release:export": "node --import tsx scripts/export-release-artifacts.ts",
    "bench:all": "node --expose-gc --import tsx scripts/bench/run-all.ts",
    "bench:parser": "node --expose-gc --import tsx scripts/bench/bench-parser.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@redocly/cli": "^2.28.1",
    "@stoplight/spectral-cli": "^6.15.1",
    "@typespec/compiler": "^1.16.0",
    "@typespec/events": "^0.86.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "@typespec/sse": "^0.86.0",
    "@typespec/streams": "^0.86.0",
    "@types/node": "^22.0.0",
    "execa": "^9.6.1",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.3",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^22.0.0"
    }
  }
}
