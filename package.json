{
  "name": "oa-sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenAPI 3.2 management monorepo — modular schemas, codegen bridge, mock server",
  "engines": {
    "node": ">=25.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "corepack pnpm build:core",
    "build:all": "turbo run build",
    "build:core": "turbo run build --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens",
    "build:downstream": "turbo run build --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server",
    "build:maintenance": "turbo run build --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock",
    "build:internal": "turbo run build --filter=@oa-sdk/nestjs-ref --filter=@oa-sdk/playground --filter=@oa-sdk/preview --filter=@oa-sdk/spec-lens-ui",
    "dev": "turbo run dev --parallel",
    "test": "corepack pnpm test:core",
    "test:all": "turbo run test --concurrency=1",
    "test:core": "turbo run test --concurrency=1 --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens",
    "test:downstream": "turbo run test --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server",
    "test:maintenance": "turbo run test --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock",
    "test:internal": "turbo run test --filter=@oa-sdk/nestjs-ref --filter=@oa-sdk/playground --filter=@oa-sdk/preview --filter=@oa-sdk/spec-lens-ui",
    "typecheck": "corepack pnpm typecheck:core",
    "typecheck:all": "turbo run typecheck",
    "typecheck:core": "turbo run typecheck --filter=@oa-sdk/core --filter=@oa-sdk/openapi-projection-contract --filter=@oa-sdk/schemas --filter=@oa-sdk/parser --filter=@oa-sdk/codegen --filter=@oa-sdk/spec-lens",
    "typecheck:downstream": "turbo run typecheck --filter=@oa-sdk/router --filter=@oa-sdk/client --filter=@oa-sdk/mock-server",
    "typecheck:maintenance": "turbo run typecheck --filter=@oa-sdk/dpm --filter=@oa-sdk/personas --filter=@oa-sdk/typia-mock",
    "typecheck:internal": "turbo run typecheck --filter=@oa-sdk/nestjs-ref --filter=@oa-sdk/playground --filter=@oa-sdk/preview --filter=@oa-sdk/spec-lens-ui",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "corepack pnpm build:core && corepack pnpm build:downstream && changeset publish",
    "schema:validate": "corepack pnpm --filter @oa-sdk/parser build && corepack pnpm --filter @oa-sdk/codegen build && corepack pnpm --filter @oa-sdk/schemas run validate && node packages/codegen/dist/cli/index.js validate --spec packages/schemas/src/.merged.yaml --require-32",
    "schema:validate:openapi": "corepack pnpm --filter @oa-sdk/parser build && corepack pnpm --filter @oa-sdk/codegen build && corepack pnpm --filter @oa-sdk/schemas run validate:openapi && node packages/codegen/dist/cli/index.js validate --spec packages/schemas/src/.merged.yaml --require-32",
    "schema:bundle": "corepack pnpm --filter @oa-sdk/schemas run bundle",
    "schema:bundle:openapi": "corepack pnpm --filter @oa-sdk/schemas run bundle:openapi",
    "schema:typespec-check": "node --import tsx scripts/schema-typespec-check.ts",
    "schema:rollback-check": "node --import tsx scripts/schema-rollback-check.ts",
    "schema:downstream-check": "node --import tsx scripts/schema-typespec-downstream-check.ts",
    "schema:preview": "corepack pnpm --filter @oa-sdk/schemas run preview",
    "schema:preview:openapi": "corepack pnpm --filter @oa-sdk/schemas run preview:openapi",
    "personas:check": "corepack pnpm --filter @oa-sdk/personas run check",
    "personas:coverage": "corepack pnpm --filter @oa-sdk/personas run coverage",
    "personas:test": "corepack pnpm --filter @oa-sdk/personas run test",
    "mock:start": "corepack pnpm --filter @oa-sdk/mock-server run start",
    "mock:dev": "corepack pnpm --filter @oa-sdk/mock-server run dev",
    "demo": "corepack pnpm --filter playground run demo",
    "demo:dpm": "corepack pnpm --filter @oa-sdk/dpm run demo",
    "demo:dpm:storage": "corepack pnpm --filter @oa-sdk/dpm run demo:storage",
    "demo:dpm:profile": "corepack pnpm --filter @oa-sdk/dpm run demo:profile",
    "build:scripts": "tsup scripts/spec-diff.ts scripts/check-api-index.ts --format esm --outDir scripts/dist --clean --platform node --external execa --external yaml --external @oa-sdk/mock-server",
    "check:api-index": "node scripts/dist/check-api-index.js",
    "check:cli-spec": "node --import tsx scripts/check-cli-spec.ts",
    "check:docs": "node --import tsx scripts/check-docs.ts",
    "test:docs-gates": "node --import tsx scripts/test-validation-gates.ts",
    "check:feature-tests": "node --import tsx scripts/check-feature-test-matrix.ts",
    "check:dpm-surface": "corepack pnpm --filter @oa-sdk/dpm run smoke:subpaths && corepack pnpm --filter @oa-sdk/dpm run smoke:extraction && corepack pnpm --filter @oa-sdk/dpm run smoke:consumer-workflow && corepack pnpm --filter @oa-sdk/dpm run smoke:pack",
    "check:release-policy": "node --import tsx scripts/check-release-policy.ts",
    "check:workspace-scope": "pnpm check:release-policy",
    "spec:diff": "node scripts/dist/spec-diff.js",
    "typespec:roundtrip": "node --import tsx scripts/typespec-roundtrip.ts",
    "typespec:bundle-check": "node --import tsx scripts/typespec-bundle-check.ts",
    "typespec:sidecar-to-extensions": "node --import tsx scripts/typespec-sidecar-to-extensions.ts",
    "typespec:create-canonical-fixture": "node --import tsx scripts/typespec-create-authored-canonical-fixture.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@redocly/cli": "^2.28.1",
    "@stoplight/spectral-cli": "^6.15.1",
    "@typespec/compiler": "^1.13.0",
    "@typespec/http": "^1.13.0",
    "@typespec/openapi": "^1.13.0",
    "@typespec/openapi3": "^1.13.0",
    "execa": "^9.6.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.3"
  }
}
