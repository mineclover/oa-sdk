f: '#/components/responses/BookResponse' },\\npackages/parser/src/__tests__/definition-registry.test.ts:517:        { $ref: '#/components/parameters/BookIdParameter' },\\npackages/parser/src/__tests__/definition-registry.test.ts:518:        { $ref: '#/components/requestBodies/CreateBookBody' },\\npackages/parser/src/__tests__/definition-registry.test.ts:519:        { $ref: '#/components/headers/RateLimitHeader' },\\npackages/parser/src/__tests__/definition-registry.test.ts:520:        { $ref: '#/components/links/BookLink' },\\npackages/parser/src/__tests__/definition-registry.test.ts:521:        { $ref: '#/components/callbacks/BookCallback' },\\npackages/parser/src/__tests__/definition-registry.test.ts:522:        { $ref: '#/components/securitySchemes/ApiKeyAuth' },\\npackages/parser/src/__tests__/definition-registry.test.ts:526:    expect(collectOutputRefs(rewritten.nodes[0]?.content).every(ref => ref.startsWith('#/components/'))).toBe(true)\\npackages/parser/src/__tests__/definition-registry.test.ts:529:  it('uses target-local output names supplied by the caller', () => {\\npackages/parser/src/__tests__/definition-registry.test.ts:552:        'schema:public/notebook/Note': 'NotebookNote',\\npackages/parser/src/__tests__/definition-registry.test.ts:558:        { $ref: '#/components/schemas/NotebookNote' },\\npackages/parser/src/__tests__/definition-registry.test.ts:564:        targetId: 'schema:public/notebook/Note',\\npackages/parser/src/__tests__/definition-registry.test.ts:566:        outputRef: '#/components/schemas/NotebookNote',\\npackages/parser/src/__tests__/definition-registry.test.ts:569:        outputName: 'NotebookNote',\\npackages/parser/src/__tests__/definition-registry.test.ts:570:        componentPath: '#/components/schemas',\\npackages/parser/src/__tests__/definition-registry.test.ts:610:        message: 'Definition ref \\\"oa://schema/public/book/Missing\\\" resolves to missing canonical id \\\"schema:public/book/Missing\\\".',\\ndocs/references/oas32/03-document-structure.md:9:In addition to the required fields, at least one of the `components`, `paths`, or `webhooks` fields MUST be present.\\ndocs/references/oas32/03-document-structure.md:14:| <a name=\\\"oas-self\\\"></a>$self | `string` | This string MUST be in the form of a URI reference as defined by [[RFC3986]] [Section 4.1](https://www.rfc-editor.org/rfc/rfc3986#section-4.1). The `$self` field provides the self-assigned URI of this document, which also serves as its base URI in accordance with [[RFC3986]] [Section 5.1.1](https://www.rfc-editor.org/rfc/rfc3986#section-5.1.1). Implementations MUST support identifying the targets of [API description URIs](#relative-references-in-api-description-uris) using the URI defined by this field when it is present. See [Establishing the Base URI](#establishing-the-base-uri) for the base URI behavior when `$self` is absent or relative, and see [Appendix F]((#appendix-f-examples-of-base-uri-determination-and-reference-resolution)) for examples of using `$self` to resolve references. |\\ndocs/references/oas32/03-document-structure.md:17:| <a name=\\\"oas-servers\\\"></a>servers | [[Server Object](#server-object)] | An array of Server Objects, which provide connectivity information to a target server. If the `servers` field is not provided, or is an empty array, the default value would be an array consisting of a single [Server Object](#server-object) with a [url](#server-url) value of `/`. |\\ndocs/references/oas32/03-document-structure.md:20:| <a name=\\\"oas-components\\\"></a>components | [Components Object](#components-object) | An element to hold various Objects for the OpenAPI Description. |\\ndocs/references/oas32/03-document-structure.md:27:To ensure interoperability, references MUST use the target document's `$self` URI if the `$self` field is present.\\ndocs/references/oas32/03-document-structure.md:48:Each document in an OAD MUST be fully parsed in order to locate possible reference targets.\\ndocs/refere