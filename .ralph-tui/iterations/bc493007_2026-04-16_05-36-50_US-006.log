2/12-schema.md:836:will indicate that the `#/components/schemas/Cat` schema is expected to match. Likewise this payload:\\ndocs/references/oas32/12-schema.md:845:will map to `#/components/schemas/Dog` because the `dog` entry in the `mapping` element maps to `Dog` which is the schema name for `#/components/schemas/Dog`.\\npackages/codegen/src/cli/commands/typegen.ts:42:        typeAliases: externalAnalysis.typeAliases.map(alias => toWorkspaceTypeAlias(resolvedSpecPath, alias)),\\npackages/codegen/src/cli/commands/typegen.ts:50:function toWorkspaceTypeAlias(resolvedSpecPath: string, alias: ExternalSchemaTypeAlias): WorkspaceTypeAliasRecord {\\npackages/codegen/src/cli/commands/typegen.ts:52:    sourceFile: alias.sourceFilePath ?? resolvedSpecPath,\\npackages/codegen/src/cli/commands/typegen.ts:53:    sourcePointer: alias.sourcePointer,\\npackages/codegen/src/cli/commands/typegen.ts:54:    refText: alias.ref,\\npackages/codegen/src/cli/commands/typegen.ts:55:    aliasName: alias.aliasName,\\npackages/codegen/src/cli/commands/typegen.ts:56:    contentHash: alias.contentHash,\\npackages/codegen/src/cli/commands/typegen.ts:57:    ...(alias.renamedFrom ? { renamedFrom: alias.renamedFrom } : {}),\\npackages/codegen/src/cli/commands/dev.ts:20:    target:         { type: 'string', description: 'hono | express (기본: hono)' },\\npackages/codegen/src/cli/commands/dev.ts:30:    const target: 'express' | 'hono' = optStr(args, 'target') === 'express' ? 'express' : 'hono'\\npackages/codegen/src/cli/commands/dev.ts:84:        writeFileSync(join(resolvedOutput, 'router.ts'), generateRouter(doc, { target, typesImport, basePath: resolvedSpec }), 'utf8')\\npackages/codegen/src/cli/commands/router.ts:13:    target:         { type: 'string', description: 'hono | express (기본: hono)' },\\npackages/codegen/src/cli/commands/router.ts:19:    const target: 'express' | 'hono' = optStr(args, 'target') === 'express' ? 'express' : 'hono'\\npackages/codegen/src/cli/commands/router.ts:21:    const opts